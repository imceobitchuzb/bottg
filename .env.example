# =====================================================================
# XAUUSD AI PRO TRADER — КОНФИГУРАЦИЯ СИСТЕМЫ
# Скопируйте этот файл в .env и укажите свои параметры:
# copy .env.example .env
# =====================================================================

# 1. Telegram Bot Token (получите у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Google Gemini API Key (для ИИ Vision анализа скриншотов графиков)
# Получите бесплатно на https://aistudio.google.com/
GEMINI_API_KEY=

# 3. Веб-сервер FastAPI (раздает Telegram Mini App)
PORT=8000
HOST=0.0.0.0

# 4. Публичный URL для Telegram Mini App (Cloudflare Tunnel обновляет автоматически при запуске run.py)
WEBAPP_URL=https://your-public-tunnel-url.trycloudflare.com

# 5. MetaTrader 5 (Параметры счёта по умолчанию - опционально)
# Можно также подключить счёт интерактивно прямо в Telegram-боте через команду /account
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
